# Copy to .env and fill in. Never commit .env.

# --- LLM provider (required for ingestion embeddings and answering) ---
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (e.g. Azure/OpenAI proxy). Leave empty for api.openai.com
OPENAI_BASE_URL=

# Model IDs. Baseline and proposed pipelines always share these.
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# --- Storage ---
# Defaults to SQLite at backend/data/app.db when unset.
# PostgreSQL example: postgresql+asyncpg://rag:rag@localhost:5432/rag
DATABASE_URL=
# DATA_DIR=backend/data
# CHROMA_DIR=
# UPLOAD_DIR=

# Optional YAML file overriding research parameters (chunking, top-k, prices, ...)
# PIPELINE_CONFIG_PATH=

# --- API ---
LOG_LEVEL=INFO
DEFAULT_CORPUS=default
MAX_UPLOAD_MB=25
# JSON list
CORS_ORIGINS=["http://localhost:5173"]
